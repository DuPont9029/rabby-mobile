+
+/// Cloneable in-process handle over [`methods`].
+#[derive(Clone)]
+pub struct MethodsHandle(Arc<Methods>);
+
+impl MethodsHandle {
+    /// Runs one JSON-RPC request string and returns the response string.
+    pub async fn call(&self, request: &str) -> std::result::Result<String, String> {
+        self.0
+            .raw_json_request(request, 1)
+            .await
+            .map(|(response, _)| response.result)
+            .map_err(|e| e.to_string())
+    }
+}
