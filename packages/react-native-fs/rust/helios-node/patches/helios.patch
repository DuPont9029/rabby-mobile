+/// The Mozilla root store (webpki-root-certs) as reqwest certificates.
+pub fn mozilla_root_certs() -> Vec<alloy::transports::http::reqwest::Certificate> {
+    webpki_root_certs::TLS_SERVER_ROOT_CERTS
+        .iter()
+        .filter_map(|der| {
+            alloy::transports::http::reqwest::Certificate::from_der(der.as_ref()).ok()
+        })
+        .collect()
+}
+
+/// HTTP client for the execution RPC. Trusts only the Mozilla root store
+/// instead of the platform verifier, which on Android needs JNI
+/// initialisation from the host app before first use.
+fn execution_http_client() -> alloy::transports::http::reqwest::Client {
+    alloy::transports::http::reqwest::Client::builder()
+        .tls_certs_only(mozilla_root_certs())
+        .build()
+        .expect("execution RPC HTTP client")
+}
